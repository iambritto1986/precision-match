VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# --- Stripe -----------------------------------------------------------------
# Price IDs are NOT secrets — they're sent to Stripe Checkout from the browser,
# so it's fine that these are VITE_ (client-side) variables.
#
# IMPORTANT: Vite inlines VITE_* values at BUILD time, not runtime. Changing
# these in the Render dashboard requires a REDEPLOY (rebuild) to take effect —
# restarting the service alone will keep serving the old value baked into the
# JS bundle. This is the most common way a price change appears not to work.
#
# Pro subscription — $9/month as of Aug 2026.
VITE_STRIPE_PRICE_PRO="price_1U1A2iKc3d6UbNausbO0WHLn"
# One-off AI credit pack.
VITE_STRIPE_PRICE_CREDITS=""

# --- Firebase Admin (server-side) -------------------------------------------
# REQUIRED IN PRODUCTION. Without it, every server-side Firestore call fails.
#
# Paste the full service-account JSON from
#   Firebase Console > Project Settings > Service Accounts > Generate new private key
# as a single value (base64 is also accepted if the dashboard mangles newlines).
#
# Do NOT rely on Application Default Credentials on Render — there are none, and
# the failure is asynchronous: the process crashes mid-request with NO_ADC_FOUND
# and the user just sees a 502.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Local development alternative — path to the same JSON on disk.
FIREBASE_SERVICE_ACCOUNT_PATH=""
# Only set this if the platform genuinely provides ADC.
# USE_APPLICATION_DEFAULT_CREDENTIALS="false"

# Server-side (never exposed to the browser).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Must match VITE_STRIPE_PRICE_CREDITS. The server compares the incoming price
# against this to decide between a one-off `payment` and a `subscription`
# checkout — if they disagree, credit packs get billed as subscriptions.
STRIPE_CREDIT_PRICE_ID=""

# Public origin, used for Stripe success/cancel redirects.
APP_URL="https://precision-match.com"
